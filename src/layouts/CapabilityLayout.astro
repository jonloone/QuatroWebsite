---
/**
 * CapabilityLayout — one template for the six capability pages (REALIGNMENT_2026-10-20 §5):
 * hero (eyebrow = layer), what you get, how it shows up in your operation, substrate line,
 * proof card or honest placeholder, hand-off to the next layer, engagement ladder, CTA.
 * Copy comes from the capabilities collection (docs/COPY_CAPABILITIES_2026-10.md).
 */
import { getCollection } from 'astro:content'
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import HeroCanvas from '@/components/marketing/HeroCanvas.astro'
import ProofCard from '@/components/marketing/ProofCard.astro'
import DualCta from '@/components/marketing/DualCta.astro'
import { engagementLadder } from '@/lib/layers'

interface Props {
  capability: any
}

const { capability } = Astro.props
const { title, hero, whatYouGet = [], showsUp = [], substrateLine, proof, handoff } = capability.data

// Link only to pages that exist today; industry and capability links switch on as their tickets land
const industryIds = new Set((await getCollection('industries')).map((e: any) => e.id.replace(/\.md$/, '')))
const capabilityIds = new Set(
  (await getCollection('capabilities')).filter((e: any) => e.data.hero).map((e: any) => e.id.replace(/\.md$/, ''))
)
const live = (href: string) => {
  const [, section, slug] = href.split('/')
  if (section === 'industries' && slug) return industryIds.has(slug)
  if (section === 'capabilities' && slug) return capabilityIds.has(slug)
  return true
}
---

<MarketingLayout title={`${title} | Capabilities`} description={hero.sub}>
  <HeroCanvas
    badge={hero.eyebrow}
    title={hero.title}
    body={hero.sub}
    ctaLabel="Talk to our team"
    ctaHref="/contact/demo"
  />

  <!-- What you get -->
  {whatYouGet.length > 0 && (
    <section class="py-20 lg:py-28 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
      <div class="mx-auto max-w-5xl grid grid-cols-1 lg:grid-cols-[35%_1fr] gap-10 lg:gap-16">
        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.1em]" style="color: var(--color-forest);">What you get</p>
        </div>
        <ul class="space-y-6">
          {whatYouGet.map((line: string, i: number) => (
            <li class="grid grid-cols-[40px_1fr] gap-4 items-start">
              <span class="font-mono text-[10px] uppercase tracking-[0.1em] pt-1.5" style="color: var(--color-forest);">{String(i + 1).padStart(2, '0')}</span>
              <span class="font-sans text-base lg:text-lg leading-relaxed" style="color: var(--color-neutral-700);">{line}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- How it shows up in your operation -->
  {showsUp.length > 0 && (
    <section class="py-20 lg:py-28 px-8 lg:px-12" style="background: var(--color-paper); border-top: 1px solid var(--color-structure);">
      <div class="mx-auto max-w-6xl">
        <p class="font-mono text-[10px] uppercase tracking-[0.1em] mb-12" style="color: var(--color-forest);">How it shows up in your operation</p>
        <div class={`grid grid-cols-1 ${showsUp.length >= 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-2'} gap-6 lg:gap-8`}>
          {showsUp.map((ex: any) => {
            const Tag = live(ex.href) ? 'a' : 'div'
            return (
              <Tag href={live(ex.href) ? ex.href : undefined} class="block rounded-xl p-6 lg:p-8 transition-colors duration-300 hover:bg-white" style="border: 1px solid var(--color-structure);">
                <h3 class="font-sans text-lg font-medium tracking-tight mb-3" style="color: var(--color-neutral-800);">{ex.industry}</h3>
                <p class="font-sans text-sm leading-relaxed" style="color: var(--color-neutral-500);">{ex.text}</p>
              </Tag>
            )
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Substrate line (Tier 1.5, §1) -->
  {substrateLine && (
    <section class="py-12 lg:py-16 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
      <p class="mx-auto max-w-5xl font-mono text-xs leading-relaxed tracking-[0.02em]" style="color: var(--color-neutral-500);">{substrateLine}</p>
    </section>
  )}

  <!-- Proof card or honest placeholder (§0.1) -->
  <section class="py-20 lg:py-28 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
    <div class="mx-auto max-w-3xl">
      <p class="font-mono text-[10px] uppercase tracking-[0.1em] mb-12" style="color: var(--color-forest);">Proof</p>
      <ProofCard card={proof} />
    </div>
  </section>

  <!-- Hand-off to the next layer -->
  {handoff && (
    <section class="py-16 lg:py-20 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
      <div class="mx-auto max-w-5xl">
        <p class="font-sans font-light text-xl lg:text-2xl leading-relaxed tracking-tight max-w-4xl" style="color: var(--color-neutral-800);">{handoff.text}</p>
        {handoff.links.some((link: any) => live(link.href)) && (
          <div class="mt-8 flex flex-wrap gap-6">
            {handoff.links.filter((link: any) => live(link.href)).map((link: any) => (
              <a href={link.href} class="font-mono text-[10px] uppercase tracking-[0.1em]" style="color: var(--color-forest);">{link.label} &rarr;</a>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Engagement ladder (§2) -->
  <section class="py-20 lg:py-28 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
    <div class="mx-auto max-w-5xl grid grid-cols-1 lg:grid-cols-[35%_1fr] gap-10 lg:gap-16">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.1em]" style="color: var(--color-forest);">How an engagement runs</p>
      </div>
      <p class="font-sans text-base lg:text-lg leading-relaxed" style="color: var(--color-neutral-500);">{engagementLadder}</p>
    </div>
  </section>

  <DualCta
    primaryCta={{ label: 'Talk to our team', href: '/contact/demo' }}
    secondaryCta={{ label: 'How an engagement runs', href: '/how-it-works/engagement' }}
    microcopy="Hosted in your country · Your team owns it from day one"
  />
</MarketingLayout>
