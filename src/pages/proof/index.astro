---
/**
 * /proof — reference work (REALIGNMENT_2026-10-20 §9A). Four abstracted pieces: what the operator
 * saw, what the team did, what it took. No client named (§0.5); honest placeholder where no capture
 * is cleared (§0.1, §13.6). Copy: COPY_ENERGY §7 (cards A and B); C and D have no write-up yet.
 */
import { getCollection } from 'astro:content'
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import HeroCanvas from '@/components/marketing/HeroCanvas.astro'
import ProofCard from '@/components/marketing/ProofCard.astro'
import DualCta from '@/components/marketing/DualCta.astro'

const sub = 'Abstracted pieces of real work: what the operator saw, what the team did, and what it took, measured in days.'

const pieces = [
  {
    card: {
      title: 'A corridor screened from orbit, confirmed by radar.',
      saw: 'The whole right of way screened weekly from open satellite data, a handful of cells flagged, before-and-after imagery on each.',
      did: 'Tasked radar through cloud on the flagged cells, correlated with line pressure, handed a confirmed site to the intelligence layer.',
      took: 'Days from first screen to confirmed cell.',
      asset: '/images/proof-energy-corridor.png',
    },
  },
  {
    card: {
      title: "A reserve's dry season, assessed from four systems.",
      saw: 'Sea-surface temperature anomaly, rainfall, surface-water extent and vegetation greenness for one territory, compared to the prior year, answered in plain language with every number cited.',
      did: 'Fused public ocean, weather and satellite records into one assessment and a watch that flags change.',
      took: 'No field hardware; the first assessment inside a month.',
      asset: null,
    },
  },
  { pendingTitle: 'A mine-site landslide, before and after.' },
  { pendingTitle: 'A grid operational picture.' },
]

// Production hardware (ENERGY_BLOCKS §2, §4, §5; NRG-BLK-4). Copy: COPY_ENERGY_BLOCKS §1 proofCard.
// Supplier-stated and labeled; supplier strips in a band, never full-bleed; supplier not named.
const hardware = {
  title: 'Production hardware',
  text: 'Storage blocks are in production and a grid-tied site has been energized in the United States (supplier-stated). A Quatro-delivered site will appear here when it is commissioned.',
  strips: [
    '/images/proof-energy-blocks-asbuilt-racks.jpg',
    '/images/proof-energy-blocks-asbuilt-aisle.jpg',
    '/images/proof-energy-blocks-asbuilt-transport.jpg',
  ],
}
const energyBlocks = (await getCollection('capabilities')).find((c: any) => c.id.replace(/\.md$/, '') === 'energy-blocks' && c.data.hero)

// Partner-delivered reference programs (§9B, PROOF-2). Copy: docs/COPY_PROOF_2026-10.md
const programs = [
  {
    name: 'Kordia',
    place: 'New Zealand',
    who: 'State-owned operator of national broadcast and emergency communications networks.',
    body: 'Kordia\'s 24/7 network operations center ran on separate tools from many vendors. DataMiner replaced them with one layer for monitoring, control and automation across more than 5,000 devices, and 98% of Kordia\'s infrastructure is now provisioned on it.',
    href: 'https://skyline.be/skyline/user/kordia',
  },
  {
    name: 'TDF',
    place: 'France',
    who: 'Broadcast and telecom infrastructure operator with 8,600 commercialized sites.',
    body: 'TDF consolidated a fragmented set of network operations tools into one system, phased network by network; digital terrestrial television alone runs to 14,000 elements. New equipment is now monitored in weeks instead of months.',
    href: 'https://skyline.be/skyline/user/tdf',
  },
]
---

<MarketingLayout title="Reference work | Quatro" description={sub}>
  <HeroCanvas
    badge="Proof"
    title="Reference work"
    body={sub}
    ctaLabel="Talk to our team"
    ctaHref="/contact/demo"
  />

  <section class="py-20 lg:py-28 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
    <div class="mx-auto max-w-6xl grid grid-cols-1 lg:grid-cols-2 gap-8">
      {pieces.map((piece: any) => (
        <ProofCard card={piece.card ?? null} pendingTitle={piece.pendingTitle} />
      ))}
      <article class="lg:col-span-2 rounded-xl overflow-hidden" style="border: 1px solid var(--color-structure);">
        <div class="p-6 lg:p-8">
          <p class="font-mono text-[10px] uppercase tracking-[0.1em] mb-3" style="color: var(--color-neutral-400);">Supplier-stated</p>
          <h3 class="font-sans font-light text-xl lg:text-2xl tracking-tight leading-[1.2] mb-4" style="color: var(--color-neutral-800);">{hardware.title}</h3>
          <p class="font-sans text-sm leading-relaxed max-w-3xl" style="color: var(--color-neutral-500);">{hardware.text}</p>
          <div class="mt-8 grid grid-cols-1 gap-4 max-w-4xl">
            {hardware.strips.map((src) => (
              <figure>
                <img src={src} alt="" class="img-technical w-full h-auto rounded-lg" loading="lazy" />
                <figcaption class="mt-2 font-mono text-[10px] uppercase tracking-[0.1em]" style="color: var(--color-neutral-400);">Supplier photograph</figcaption>
              </figure>
            ))}
          </div>
          {energyBlocks && (
            <a href="/capabilities/energy-blocks" class="inline-block mt-8 font-mono text-[10px] uppercase tracking-[0.1em]" style="color: var(--color-forest);">{energyBlocks.data.title} &rarr;</a>
          )}
        </div>
      </article>
    </div>
  </section>

  <section class="py-20 lg:py-28 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
    <div class="mx-auto max-w-6xl">
      <p class="font-mono text-[10px] uppercase tracking-[0.1em] mb-4" style="color: var(--color-forest);">Partner-delivered reference programs</p>
      <h2 class="font-sans font-light text-3xl lg:text-4xl tracking-tight leading-[1.15] max-w-3xl mb-6" style="color: var(--color-neutral-800);">The operational model, in production with critical-infrastructure operators.</h2>
      <p class="font-sans text-base leading-relaxed max-w-3xl mb-12" style="color: var(--color-neutral-500);">These programs were delivered by Skyline Communications, the company that builds DataMiner, for its own customers. We cite them with Skyline's permission to show the operational model at national scale.</p>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {programs.map((p) => (
          <article class="rounded-xl p-6 lg:p-8" style="border: 1px solid var(--color-structure);">
            <p class="font-mono text-[10px] uppercase tracking-[0.1em] mb-3" style="color: var(--color-neutral-400);">{p.place}</p>
            <h3 class="font-sans font-light text-xl lg:text-2xl tracking-tight leading-[1.2] mb-2" style="color: var(--color-neutral-800);">{p.name}</h3>
            <p class="font-sans text-sm leading-relaxed mb-4" style="color: var(--color-neutral-600);">{p.who}</p>
            <p class="font-sans text-sm leading-relaxed mb-6" style="color: var(--color-neutral-500);">{p.body}</p>
            <a href={p.href} target="_blank" rel="noopener" class="font-mono text-[10px] uppercase tracking-[0.1em]" style="color: var(--color-forest);">Read the story on skyline.be &rarr;</a>
          </article>
        ))}
      </div>
      <p class="font-sans text-xs mt-8" style="color: var(--color-neutral-400);">Figures as published by Skyline Communications.</p>
    </div>
  </section>

  <DualCta
    primaryCta={{ label: 'Talk to our team', href: '/contact/demo' }}
    secondaryCta={{ label: 'How an engagement runs', href: '/how-it-works/engagement' }}
    microcopy="Hosted in your country · Your team owns it from day one"
  />
</MarketingLayout>
