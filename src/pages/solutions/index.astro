---
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import HeroCanvas from '@/components/marketing/HeroCanvas.astro'
import Section from '@/components/marketing/Section.astro'
import DualCta from '@/components/marketing/DualCta.astro'

const capabilities = [
  {
    number: '01',
    title: 'Asset & Infrastructure Intelligence',
    problem: 'Physical assets degrade across complex environments. When SCADA, maintenance tickets, and inspections live in different systems, teams react to failures instead of preventing them.',
    outputs: 'Grid health monitoring, pipeline integrity, predictive maintenance routing, and unified asset status.',
    industries: 'Energy, Smart Cities, Critical Infrastructure',
    links: [
      { name: 'Grid Health', href: '/solutions/grid-health' },
      { name: 'Pipeline Integrity', href: '/solutions/pipeline-integrity' },
      { name: 'Asset Health', href: '/solutions/asset-health' }
    ]
  },
  {
    number: '02',
    title: 'Operator Guidance & Response',
    problem: "During an incident, operators shouldn't be searching for manuals or cross-referencing systems. They need immediate, contextual guidance tied to the specific asset and failure mode.",
    outputs: 'Incident triage, root-cause analysis support, automated playbook recommendations, and field dispatch coordination.',
    industries: 'Energy, Networks, Maritime, Logistics',
    links: [
      { name: 'Operational Intelligence', href: '/solutions/operational-intelligence' },
      { name: 'Network Operations', href: '/solutions/network-operations' }
    ]
  },
  {
    number: '03',
    title: 'Logistics Exception Management',
    problem: "Supply chain visibility tools only show you a delay. They don't help you resolve it. Manual exception handling across carriers, warehouses, and customs slows down the entire network.",
    outputs: 'Disruption triage, route impact analysis, automated customer communication drafts, and berth-to-gate coordination.',
    industries: 'Logistics, Supply Chain, Maritime, Ports',
    links: [
      { name: 'Fleet Logistics', href: '/solutions/fleet-logistics' },
      { name: 'Fleet Health', href: '/solutions/fleet-health' },
      { name: 'Port Operations', href: '/solutions/port-operations' }
    ]
  },
  {
    number: '04',
    title: 'Compliance & Governance Workflows',
    problem: "Regulatory reporting and compliance evidence are often assembled after the fact. Overlapping obligations across physical and cyber domains create massive audit risk.",
    outputs: 'Automated regulatory reporting, continuous compliance monitoring, audit-ready evidence packages, and physical security tracking.',
    industries: 'Energy, Defense, Smart Cities',
    links: [
      { name: 'Regulatory Compliance', href: '/solutions/regulatory-compliance' },
      { name: 'Environmental Compliance', href: '/solutions/environmental-compliance' },
      { name: 'Physical Security', href: '/solutions/physical-security' }
    ]
  },
  {
    number: '05',
    title: 'Service & Revenue Assurance',
    problem: 'When a network fault occurs, NOCs struggle to correlate the technical failure with the specific mission, customer, or revenue stream impacted.',
    outputs: 'SLA monitoring, hybrid network correlation, revenue leakage detection, and mission-aware service degradation triage.',
    industries: 'Networks, SATCOM, Defense, Telecom',
    links: [
      { name: 'Service Assurance', href: '/solutions/service-assurance' },
      { name: 'Revenue Assurance', href: '/solutions/revenue-assurance' },
      { name: 'Teleport Operations', href: '/solutions/teleport-operations' }
    ]
  },
  {
    number: '06',
    title: 'Cross-Agency Domain Awareness',
    problem: 'Intelligence and security teams cannot effectively correlate threats when data is siloed across different agencies, jurisdictions, and classification levels.',
    outputs: 'Shared situational awareness, source-to-assessment traceability, analyst augmentation, and governed intelligence sharing.',
    industries: 'Intelligence, Defense, Smart Cities',
    links: [
      { name: 'Space Domain Awareness', href: '/solutions/space-domain-awareness' },
      { name: 'Corridor Intelligence', href: '/solutions/corridor-intelligence' }
    ]
  }
]
---

<MarketingLayout
  title="Solutions — Operational Workflows Quatro Integrates"
  description="Quatro integrates data, reasoning, agents, and workflows around the operational problems your team needs to solve first."
>
  <HeroCanvas
    badge="Capabilities"
    title="Operational workflows that drive action"
    body="We organize our solutions around the concrete operational problems your team needs to solve. Pick a workflow, connect the systems that matter, and start building your intelligence stack."
    ctaLabel="Talk to Our Team"
    ctaHref="/contact/demo"
  />

  {capabilities.map((capability) => (
    <Section>
      <div class="space-y-8">
        {/* Capability Header */}
        <div class="space-y-4">
          <div class="inline-flex items-baseline gap-6">
            <span class="font-display text-5xl font-bold text-emerald-700">{capability.number}</span>
            <h2 class="font-display text-3xl font-bold text-neutral-900">{capability.title}</h2>
          </div>
        </div>

        {/* Problem Statement */}
        <div>
          <p class="text-lg text-neutral-700 leading-relaxed">{capability.problem}</p>
        </div>

        {/* What Your Team Gets */}
        <div class="border-l-4 border-emerald-700 pl-6 py-4">
          <h3 class="font-display text-sm font-semibold text-neutral-600 uppercase tracking-wide mb-2">What your team gets</h3>
          <p class="text-neutral-700">{capability.outputs}</p>
        </div>

        {/* Applied Across */}
        <div>
          <p class="text-sm text-neutral-600 font-medium">
            <span class="font-semibold">Applied across:</span> {capability.industries}
          </p>
        </div>

        {/* Divider */}
        <div class="border-t border-neutral-200 pt-8" />
      </div>
    </Section>
  ))}

  {/* Flexibility Section */}
  <Section>
    <div class="space-y-6">
      <div class="space-y-3">
        <p class="font-display text-sm font-semibold text-emerald-700 uppercase tracking-wide">The Flexibility</p>
        <h2 class="font-display text-3xl font-bold text-neutral-900">Same architecture. Your operational context.</h2>
      </div>
      <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl">
        Every capability runs on the same integration architecture — 8,000+ connections, governed by your rules, deployed on your infrastructure. The operational model adapts to your domain. Your team extends it from there.
      </p>
    </div>
  </Section>

  <DualCta
    title="See what industrial AI integration looks like for your operation."
    description="Tell us the first workflow that matters. We connect the systems, add reasoning and agents, and route the result through a governed model your team owns."
    primaryCta={{ label: 'Talk to Our Team', href: '/contact/demo' }}
    secondaryCta={{ label: 'Become a Partner', href: '/partners' }}
    microcopy="Intelligence in weeks · Your team owns it from day one"
  />
</MarketingLayout>
