---
import { getCollection } from 'astro:content'
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import HeroCanvas from '@/components/marketing/HeroCanvas.astro'
import Section from '@/components/marketing/Section.astro'
import IndustryHubCard from '@/components/marketing/IndustryHubCard.astro'
import DualCta from '@/components/marketing/DualCta.astro'

// Pull all industries from content
const allIndustries = await getCollection('industries')
const getIndustry = (slug: string) => allIndustries.find((i) => i.id === slug || i.id === `${slug}.md`)

// Define the canonical verticals with overlays.
// Routes are preserved for now; visible labels align to the locked Quatro canon.
const pillars = [
  {
    name: 'Smart Cities & Utilities',
    description: 'Industrial AI for city, utility, water, waste, mobility, field-service, and public infrastructure workflows.',
    href: '/industries/cities',
    image: getIndustry('cities')?.data.heroImage || '/images/industry-cities.png',
    children: [
      { name: 'Water Systems', href: '/industries/water-environment' },
      { name: 'Environmental Compliance', href: '/solutions/environmental-compliance' },
      { name: 'Public Works Coordination', href: '/industries/cities' },
    ],
  },
  {
    name: 'Oil & Gas / Energy',
    description: 'Pipeline, grid, production, maintenance, safety, and environmental workflows connected into one governed operating model.',
    href: '/industries/energy',
    image: getIndustry('energy')?.data.heroImage || '/images/industry-energy.png',
    children: [
      { name: 'Grid Health', href: '/solutions/grid-health' },
      { name: 'Pipeline Integrity', href: '/solutions/pipeline-integrity' },
      { name: 'Asset Health', href: '/solutions/asset-health' },
    ],
  },
  {
    name: 'Maritime / Ports',
    description: 'Port, terminal, vessel, cargo, customs, and maritime-domain workflows coordinated through human-approved intelligence.',
    href: '/solutions/port-operations',
    image: '/images/solution-port-operations.png',
    children: [
      { name: 'Port Operations', href: '/solutions/port-operations' },
      { name: 'Maritime Awareness', href: '/industries/defense/maritime-awareness' },
      { name: 'Corridor Intelligence', href: '/solutions/corridor-intelligence' },
    ],
  },
  {
    name: 'Logistics / Supply Chain',
    description: 'Fleet, freight, exception, route, corridor, warehouse, and customer-impact workflows connected into governed action.',
    href: '/industries/transportation',
    image: getIndustry('transportation')?.data.heroImage || '/images/industry-transportation.png',
    children: [
      { name: 'Fleet Logistics', href: '/solutions/fleet-logistics' },
      { name: 'Fleet Health', href: '/solutions/fleet-health' },
      { name: 'Service Assurance', href: '/solutions/service-assurance' },
    ],
  },
  {
    name: 'Intelligence',
    description: 'Source-to-assessment workflows for mission, analyst, cross-agency, infrastructure-risk, and operational-intelligence teams.',
    href: '/industries/defense',
    image: getIndustry('defense')?.data.heroImage || '/images/industry-defense.png',
    children: [
      { name: 'Physical Security', href: '/solutions/physical-security' },
      { name: 'Space Domain Awareness', href: '/solutions/space-domain-awareness' },
      { name: 'Mission Logistics', href: '/industries/defense/mission-logistics' },
    ],
  },
  {
    name: 'Defense overlay',
    description: 'A cross-cutting overlay for missions that require human command authority, responsible AI posture, and audit-signed action.',
    href: '/industries/defense',
    image: getIndustry('defense')?.data.heroImage || '/images/industry-defense.png',
    children: [
      { name: 'Base Protection', href: '/industries/defense/base-protection' },
      { name: 'Mission Logistics', href: '/industries/defense/mission-logistics' },
      { name: 'Maritime Awareness', href: '/industries/defense/maritime-awareness' },
    ],
  },
  {
    name: 'Networks & SATCOM overlay',
    description: 'A cross-cutting overlay for connectivity, service assurance, NOC, satellite, edge, and mission-aware network operations.',
    href: '/industries/networks',
    image: getIndustry('networks')?.data.heroImage || '/images/industry-networks.png',
    children: [
      { name: 'Network Operations', href: '/solutions/network-operations' },
      { name: 'Teleport Operations', href: '/solutions/teleport-operations' },
      { name: 'Revenue Assurance', href: '/solutions/revenue-assurance' },
    ],
  },
]
---

<MarketingLayout
  title="Industries — Industrial AI for Critical Operations"
  description="Quatro integrates data, reasoning, agents, and workflows for smart cities, energy, ports, logistics, and intelligence teams — with defense and networks/SATCOM overlays."
>
  <HeroCanvas
    badge="Industries"
    title="Industrial AI for the operations that keep society running"
    body="Quatro adapts one customer-owned intelligence stack — data, reasoning, agents, and workflows — to the operating reality of each industry."
    ctaLabel="Talk to Our Team"
    ctaHref="/contact/demo"
  />

  <!-- TOP TWO PILLARS — Full-width landscape cards -->
  <Section>
    <div class="mb-10 fade-up">
      <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-neutral-400 mb-3">Industries</p>
      <h2 class="font-display text-2xl font-bold text-neutral-800 sm:text-3xl tracking-tight">
        Choose Your Domain
      </h2>
    </div>

    <div class="space-y-6">
      {pillars.map((pillar, i) => (
        <IndustryHubCard
          title={pillar.name}
          description={pillar.description}
          href={pillar.href}
          heroImage={pillar.heroImage}
          solutions={pillar.children}
          reverse={i % 2 === 1}
        />
      ))}
    </div>
  </Section>

  <!-- STACK STRIP -->
  <Section divider dark>
    <div class="mx-auto max-w-3xl text-center fade-up">
      <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-white/60 mb-4">Stack</p>
      <h2 class="font-display text-2xl font-bold text-white sm:text-3xl">
        One Architecture. Every Vertical.
      </h2>
      <p class="mt-4 text-lg text-white/70 leading-relaxed">
        8,000+ integrations. AI models trained on operational data. On-premise, cloud, or air-gapped deployment. Quatro adapts the same core architecture to your sector's specific systems and compliance requirements.
      </p>
      <div class="mt-10 grid grid-cols-3 gap-px max-w-xl mx-auto" style="background: rgba(255,255,255,0.08);">
        <div class="py-6 text-center" style="background: var(--color-neutral-800);">
          <div class="text-2xl font-bold text-white">8,000+</div>
          <div class="mt-1 text-[10px] uppercase tracking-wider text-white/40">Integrations</div>
        </div>
        <div class="py-6 text-center" style="background: var(--color-neutral-800);">
          <div class="text-2xl font-bold text-white">4 Weeks</div>
          <div class="mt-1 text-[10px] uppercase tracking-wider text-white/40">To First Value</div>
        </div>
        <div class="py-6 text-center" style="background: var(--color-neutral-800);">
          <div class="text-2xl font-bold text-white">Your Cloud</div>
          <div class="mt-1 text-[10px] uppercase tracking-wider text-white/40">Or On-Premise</div>
        </div>
      </div>
    </div>
  </Section>

  <DualCta
    title={`See what <span style="color: var(--color-forest);">industrial AI integration</span> looks like for your industry.`}
    description="Tell us the first workflow that matters. We connect the systems, add reasoning and agents, and route work through a governed model your team owns."
    primaryCta={{ label: 'Talk to Our Team', href: '/contact/demo' }}
    secondaryCta={{ label: 'Talk to an Engineer', href: '/contact/sales' }}
    microcopy="Intelligence in weeks · Your team owns it from day one"
  />
</MarketingLayout>
