---
/**
 * /industries — the active industries from the collection, in spec order (REALIGNMENT_2026-10-20 §7).
 * Retired and folded industries live as `.retired` files and 301 elsewhere (IND-6).
 */
import { getCollection } from 'astro:content'
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import HeroCanvas from '@/components/marketing/HeroCanvas.astro'
import Section from '@/components/marketing/Section.astro'
import IndustryHubCard from '@/components/marketing/IndustryHubCard.astro'
import DualCta from '@/components/marketing/DualCta.astro'

const industries = (await getCollection('industries'))
  .filter((i: any) => i.data.status === 'active' || i.data.status === 'emerging')
  .sort((a: any, b: any) => a.data.order - b.data.order)
  .map((i: any) => {
    const href = `/industries/${i.id.replace(/\.md$/, '')}`
    return {
      title: i.data.title,
      description: i.data.hero?.title || i.data.tagline,
      href,
      heroImage: i.data.heroImage,
      solutions: i.data.capabilities.filter((c: any) => c.featured).slice(0, 3).map((c: any) => ({ name: c.name, href })),
    }
  })

// §2 sub, verbatim
const sub =
  'One operational picture of your territory and your operations, from satellite to SCADA to the field, run in your country and owned by you from day one.'
---

<MarketingLayout title="Industries | Quatro" description={sub}>
  <HeroCanvas
    badge="Industries"
    title="Making critical infrastructure intelligent."
    body={sub}
    ctaLabel="Talk to our team"
    ctaHref="/contact/demo"
  />

  <Section>
    <div class="space-y-6">
      {industries.map((industry: any, i: number) => (
        <IndustryHubCard
          title={industry.title}
          description={industry.description}
          href={industry.href}
          heroImage={industry.heroImage}
          solutions={industry.solutions}
          reverse={i % 2 === 1}
        />
      ))}
    </div>
  </Section>

  <DualCta
    primaryCta={{ label: 'Talk to our team', href: '/contact/demo' }}
    secondaryCta={{ label: 'How an engagement runs', href: '/how-it-works/engagement' }}
    microcopy="Hosted in your country · Your team owns it from day one"
  />
</MarketingLayout>
