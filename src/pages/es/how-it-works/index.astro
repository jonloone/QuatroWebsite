---
/**
 * /es/how-it-works — one page (CULL-3; REALIGNMENT_2026-11-02_CULL §E; COPY_CULL §4).
 * Merges the former index, engagement and sovereignty pages verbatim under #picture, #engagement and
 * #sovereignty, with the managed-service table under #sovereignty. Architecture is retired (301 to #picture).
 */
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import HeroCanvas from '@/components/marketing/HeroCanvas.astro'
import SpineBand from '@/components/marketing/SpineBand.astro'
import DualCta from '@/components/marketing/DualCta.astro'
import { layersEs, layerPromiseEs } from '@/lib/layers'

const layerBeats = layersEs.map((layer) => ({
  id: layer.id,
  index: layer.index,
  label: layer.label,
  oneLiner: layer.headline,
}))

const sub =
  'Un solo cuadro operativo de su territorio y de su operación, del satélite al SCADA y al campo, operado en su país y de su propiedad desde el primer día.'

const engagementSub =
  'Empiece por su área de mayor riesgo y decida con los resultados, medidos contra indicadores acordados de antemano.'

const proofOfValue = [
  'La línea base satelital arranca primero porque no requiere hardware de campo, así que los resultados empiezan durante la construcción.',
  'Un primer cuadro operativo de su área de mayor riesgo en unos 30 días.',
  'Luego una evaluación de 90 días medida contra indicadores acordados de antemano. En un corredor son las detecciones confirmadas en el derecho de vía, menos falsas alarmas y una respuesta más rápida.',
  'Conserva el acceso durante un año completo. La renovación y la ampliación se deciden con resultados.',
]

const youSupply = [
  'Acceso a los sistemas que tienen los datos (SCADA, historiadores, GIS) en los primeros 60 días.',
  'Un equipo contraparte que revisa cada entregable en diez días hábiles y firma la compuerta.',
  'Una decisión de alojamiento: en cuál de las tres modalidades corre el cuadro, elegida mientras se redacta el alcance de trabajo.',
]

const sovereigntySub =
  'En lenguaje corriente, qué se queda en su país y qué puede hacer la IA. El anexo del contrato contiene el texto vinculante.'

const blocks = [
  { title: 'Información de vigilancia', text: 'Llega solo a los roles que usted autoriza. Queda fuera de los tickets de soporte y de las herramientas en el exterior, y una orden de imágenes nunca lo nombra a usted ni su propósito.' },
  { title: 'Datos personales', text: 'Bajo la Ley Orgánica de Protección de Datos Personales (LOPDP), Quatro actúa como encargado del tratamiento según sus instrucciones, recoge solo lo que el trabajo necesita y seudonimiza donde puede.' },
  { title: 'Lo que es suyo', text: 'Sus datos y cada producto derivado son suyos desde que existen. Las reglas, umbrales y flujos construidos para usted también lo son, entregados en formatos abiertos que puede llevar a otro proveedor.' },
  { title: 'Configuración y credenciales', text: 'La configuración, la arquitectura y las credenciales del sistema son confidenciales. Las llaves quedan bajo su custodia, y la administración remota pasa por autenticación multifactor con cada sesión grabada.' },
  { title: 'Dónde corre', text: 'Los datos, los respaldos, los registros y las llaves se quedan en el país. Usted elige un centro de datos en el país gestionado por nosotros, una nube de gobierno o privada en el país, o sus propias instalaciones, y puede migrar entre ellas. Un sitio remoto sigue funcionando cuando cae el enlace.' },
  { title: 'Lo que puede hacer la IA', text: 'La inferencia corre en el país, y ningún modelo de terceros se entrena con sus datos. Cada modelo queda registrado, y usted conoce un cambio antes de que llegue a producción. Los modelos son reemplazables, incluidos los de pesos abiertos. Las reglas son explícitas y versionadas, y cada resultado lleva su traza. La IA aconseja, un funcionario decide y firma, y usted puede apagar cualquier función de IA.' },
  { title: 'Cuando termina', text: 'Una exportación completa en 30 días, 90 días de apoyo a la transición y eliminación certificada.' },
]

const managedService = [
  { label: 'Operación', line: 'En el país a cargo de Quatro Ecuador, con soporte de 07:00 a 22:00, los siete días de la semana.' },
  { label: 'Acompañamiento', line: '90 días de acompañamiento intensivo después de cada puesta en marcha.' },
  { label: 'Niveles de servicio', line: 'Reportados cada mes a su comité directivo.' },
  { label: 'Alojamiento', line: 'Un centro de datos en el país gestionado por nosotros, una nube de gobierno o privada con todas sus regiones en el país, o sus propias instalaciones. Puede migrar entre ellas.' },
  { label: 'Anexo de IA', line: 'La inferencia se queda en infraestructura soberana, ningún modelo de terceros se entrena con sus datos, los modelos son reemplazables y las llaves quedan bajo su custodia.' },
  { label: 'En sitio', line: 'Un ingeniero desplegado en sitio, y capacitación en español para operadores, analistas y personal de mantenimiento.' },
]
---

<MarketingLayout lang="es" title="Cómo funciona | Quatro" description={sub}>
  <HeroCanvas
    badge="Cómo funciona"
    title="Un solo sistema, del sensor a la decisión firmada."
    body={sub}
    ctaLabel="Hable con nuestro equipo"
    ctaHref="/es/contact/demo"
  />

  <section id="picture" class="scroll-mt-24 pt-20 lg:pt-28 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
    <div class="mx-auto max-w-5xl">
      <p class="font-mono text-[10px] uppercase tracking-[0.1em]" style="color: var(--color-forest);">El cuadro operativo</p>
    </div>
  </section>
  <SpineBand beats={layerBeats} promise={layerPromiseEs} foundation={null} ariaLabel="Territorio, operación, la capa de Quatro" />

  <section class="py-20 lg:py-28 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
    <div class="mx-auto max-w-5xl">
      <p class="font-sans font-light text-2xl lg:text-4xl leading-[1.25] tracking-tight max-w-4xl" style="color: var(--color-neutral-800);">
        Los agentes proponen. Su equipo decide. Cada acción queda firmada. La inteligencia y el despliegue son suyos desde el primer día.
      </p>
      <p class="mt-8 font-sans text-base lg:text-lg leading-relaxed max-w-3xl" style="color: var(--color-neutral-500);">
        Cada acción del sistema queda registrada y es auditable, y sus datos siguen bajo su control.
      </p>
    </div>
  </section>

  <section id="engagement" class="scroll-mt-24 pt-20 lg:pt-28 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
    <div class="mx-auto max-w-5xl">
      <p class="font-mono text-[10px] uppercase tracking-[0.1em]" style="color: var(--color-forest);">Cómo se ejecuta un compromiso</p>
      <p class="mt-6 font-sans text-lg lg:text-xl leading-relaxed max-w-3xl" style="color: var(--color-neutral-700);">{engagementSub}</p>
    </div>
  </section>
  <section class="py-20 lg:py-28 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
    <div class="mx-auto max-w-5xl grid grid-cols-1 lg:grid-cols-[35%_1fr] gap-10 lg:gap-16">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.1em] mb-3" style="color: var(--color-forest);">01</p>
        <h2 class="font-sans font-light text-2xl lg:text-3xl tracking-tight" style="color: var(--color-neutral-800);">Prueba de valor, de 30 a 90 días</h2>
      </div>
      <div>
        <ul class="space-y-5">
          {proofOfValue.map((line) => (
            <li class="font-sans text-base lg:text-lg leading-relaxed" style="color: var(--color-neutral-700);">{line}</li>
          ))}
        </ul>
        <div class="mt-12 rounded-xl p-6 lg:p-8" style="background: var(--color-paper); border: 1px solid var(--color-structure);">
          <p class="font-mono text-[10px] uppercase tracking-[0.1em] mb-3" style="color: var(--color-forest);">La compuerta</p>
          <p class="font-sans text-base leading-relaxed" style="color: var(--color-neutral-700);">Antes de pedir cualquier equipo de campo, ambas partes aprueban el mapa de calor de riesgo, las áreas de interés y el plan de ubicación de sensores.</p>
        </div>
        <p class="mt-12 font-mono text-[10px] uppercase tracking-[0.1em] mb-5" style="color: var(--color-forest);">Lo que aporta su institución</p>
        <ul class="space-y-4">
          {youSupply.map((line) => (
            <li class="font-sans text-base leading-relaxed" style="color: var(--color-neutral-500);">{line}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
    <div class="mx-auto max-w-5xl grid grid-cols-1 lg:grid-cols-[35%_1fr] gap-10 lg:gap-16">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.1em] mb-3" style="color: var(--color-forest);">02</p>
        <h2 class="font-sans font-light text-2xl lg:text-3xl tracking-tight" style="color: var(--color-neutral-800);">Un servicio anual que opera su equipo</h2>
      </div>
      <p class="font-sans text-base lg:text-lg leading-relaxed" style="color: var(--color-neutral-700);">
        Con precio anual y renovado con resultados. Alojamiento en el país, soporte de 07:00 a 22:00 los siete días de la semana, 90 días de acompañamiento intensivo después de la puesta en marcha y un informe mensual de servicio a su comité directivo.
      </p>
    </div>
  </section>

  <section class="py-20 lg:py-28 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
    <div class="mx-auto max-w-5xl grid grid-cols-1 lg:grid-cols-[35%_1fr] gap-10 lg:gap-16">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.1em] mb-3" style="color: var(--color-forest);">03</p>
        <h2 class="font-sans font-light text-2xl lg:text-3xl tracking-tight" style="color: var(--color-neutral-800);">Un programa, por tramos</h2>
      </div>
      <p class="font-sans text-base lg:text-lg leading-relaxed" style="color: var(--color-neutral-700);">
        Para programas nacionales, la construcción avanza por tramos a través de un consorcio liderado por un integrador local, su única contraparte contractual. Cada tramo después del primero tiene su propio contrato, así que nada más allá del primero queda comprometido hasta que usted lo firma. Un comité directivo mensual, presidido por el integrador local, gobierna el programa.
      </p>
    </div>
  </section>

  <section id="sovereignty" class="scroll-mt-24 pt-20 lg:pt-28 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
    <div class="mx-auto max-w-5xl">
      <p class="font-mono text-[10px] uppercase tracking-[0.1em]" style="color: var(--color-forest);">Soberanía, alojamiento y servicio gestionado</p>
      <p class="mt-6 font-sans text-lg lg:text-xl leading-relaxed max-w-3xl" style="color: var(--color-neutral-700);">{sovereigntySub}</p>
    </div>
  </section>
  <section class="py-20 lg:py-28 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
    <div class="mx-auto max-w-5xl space-y-12 lg:space-y-16">
      {blocks.map((block, i) => (
        <div class="grid grid-cols-1 lg:grid-cols-[35%_1fr] gap-4 lg:gap-16 pb-12 lg:pb-16" style={i < blocks.length - 1 ? 'border-bottom: 1px solid var(--color-structure);' : ''}>
          <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.1em] mb-3" style="color: var(--color-forest);">{String(i + 1).padStart(2, '0')}</p>
            <h2 class="font-sans font-light text-2xl lg:text-3xl tracking-tight" style="color: var(--color-neutral-800);">{block.title}</h2>
          </div>
          <p class="font-sans text-base lg:text-lg leading-relaxed" style="color: var(--color-neutral-700);">{block.text}</p>
        </div>
      ))}
    </div>
  </section>


  <section class="py-20 lg:py-28 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
    <div class="mx-auto max-w-5xl">
      <dl>
        {managedService.map((row) => (
          <div class="grid grid-cols-1 lg:grid-cols-[35%_1fr] gap-2 lg:gap-16 py-5" style="border-top: 1px solid var(--color-structure);">
            <dt class="font-mono text-[10px] uppercase tracking-[0.1em] pt-1" style="color: var(--color-forest);">{row.label}</dt>
            <dd class="font-sans text-base leading-relaxed" style="color: var(--color-neutral-700);">{row.line}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <DualCta
    primaryCta={{ label: 'Hable con nuestro equipo', href: '/es/contact/demo' }}
    secondaryCta={{ label: 'Trabajo de referencia', href: '/es/proof' }}
    microcopy="Alojado en su país · Su equipo es dueño desde el primer día"
  />
</MarketingLayout>
