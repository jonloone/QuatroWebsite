---
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import Hero from '@/components/marketing/Hero.astro'
import Section from '@/components/marketing/Section.astro'
import DualCta from '@/components/marketing/DualCta.astro'
import Placeholder from '@/components/marketing/Placeholder.astro'
---

<MarketingLayout
  lang="es"
  title="Nosotros — Integrador de IA industrial para las Américas"
  description="Quatro es el integrador de IA industrial para las Américas. Integramos el stack de inteligencia sobre el cual sus operadores hacen funcionar su infraestructura crítica."
>
  <Hero
    eyebrow="Sobre Quatro"
    title="Haciendo inteligente la infraestructura crítica de las Américas."
    description="Quatro es el integrador de IA industrial para las Américas. Integramos el stack de inteligencia sobre el cual sus operadores hacen funcionar su infraestructura crítica."
  />

  <Section>
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold text-neutral-800">Nuestra Misión</h2>
        <p class="mt-4 text-lg text-neutral-600">
          Existimos para hacer inteligente la infraestructura crítica de las Américas. Integramos hardware en el borde, modelos y agentes que razonan sobre los datos operacionales de su equipo, y los flujos de trabajo que sus operadores usan en cada turno. Su organización es dueña del stack desde el primer día.
        </p>
      </div>
      <Placeholder label="Company Image" class="min-h-[300px]" />
    </div>
  </Section>

  <DualCta
    title={`Vea cómo las <span style="color: var(--color-forest);">operaciones inteligentes</span> funcionan en su industria.`}
    description="Cuéntenos el resultado que importa. Conectamos los sistemas que tienen la respuesta. Su equipo empieza a operar desde el modelo."
    primaryCta={{ label: 'Hable con nuestro equipo', href: '/es/contact/demo' }}
    secondaryCta={{ label: 'Explore nuestras industrias', href: '/es/industries' }}
    microcopy="Inteligencia en semanas · Su equipo es dueño desde el primer día"
  />
</MarketingLayout>
