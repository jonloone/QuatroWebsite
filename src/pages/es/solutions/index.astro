---
import { getCollection } from 'astro:content'
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import HeroCanvas from '@/components/marketing/HeroCanvas.astro'
import Section from '@/components/marketing/Section.astro'
import DualCta from '@/components/marketing/DualCta.astro'

const solutions = (await getCollection('solutions-es')).sort((a, b) => a.data.order - b.data.order)
---

<MarketingLayout
  lang="es"
  title="Soluciones — Stack de inteligencia para sus operaciones"
  description="Quatro integra el stack de inteligencia para monitoreo de activos, integridad de ductos, operaciones de red, inteligencia operacional y más."
>
  <HeroCanvas
    badge="Soluciones"
    title="Soluciones para cada operación crítica."
    body="Desde la salud de activos hasta las operaciones de red, Quatro integra el stack de inteligencia que sus operadores usan para hacer funcionar su infraestructura crítica en cada turno."
    ctaLabel="Hable con nuestro equipo"
    ctaHref="/es/contact/demo"
  />

  <Section>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {solutions.map((solution) => (
        <a
          href={`/es/solutions/${solution.id.replace(/\.md$/, '')}`}
          class="group flex flex-col rounded-xl border border-neutral-200 bg-white p-6 transition-all hover:border-brand-300 hover:shadow-md"
        >
          <h3 class="font-display text-lg font-bold text-neutral-800 group-hover:text-brand-600">
            {solution.data.title}
          </h3>
          <p class="mt-2 flex-1 text-sm text-neutral-600">{solution.data.description}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {solution.data.stats.slice(0, 2).map((stat) => (
              <span class="rounded-full bg-neutral-100 px-2 py-0.5 text-xs font-medium text-neutral-600">
                {stat.value} {stat.label}
              </span>
            ))}
          </div>
          <span class="mt-4 inline-block font-display text-sm font-semibold text-brand-500 group-hover:underline">
            Explorar solución &rarr;
          </span>
        </a>
      ))}
    </div>
  </Section>

  <DualCta
    title={`Vea el <span style="color: var(--color-forest);">stack de inteligencia</span> sobre sus datos.`}
    description="Cuéntenos el resultado que importa. Conectamos los sistemas que tienen la respuesta. Su equipo empieza a operar desde el modelo."
    primaryCta={{ label: 'Hable con nuestro equipo', href: '/es/contact/demo' }}
    secondaryCta={{ label: 'Hable con un ingeniero', href: '/es/contact/sales' }}
    microcopy="Inteligencia en semanas · Su equipo es dueño desde el primer día"
  />
</MarketingLayout>
