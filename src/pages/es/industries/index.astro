---
/**
 * /es/industries — Spanish mirror of /industries (ES-IND-1): the active and emerging industries from
 * industries-es, in spec order (§7). Retired and folded ES industries 301 elsewhere.
 */
import { getCollection } from 'astro:content'
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import HeroCanvas from '@/components/marketing/HeroCanvas.astro'
import Section from '@/components/marketing/Section.astro'
import IndustryHubCard from '@/components/marketing/IndustryHubCard.astro'
import DualCta from '@/components/marketing/DualCta.astro'

const industries = (await getCollection('industries-es'))
  .filter((i: any) => i.data.status === 'active' || i.data.status === 'emerging')
  .sort((a: any, b: any) => a.data.order - b.data.order)
  .map((i: any) => {
    const href = `/es/industries/${i.id.replace(/\.md$/, '')}`
    return {
      title: i.data.title,
      description: i.data.hero?.title || i.data.tagline,
      href,
      heroImage: i.data.heroImage,
      solutions: i.data.capabilities.filter((c: any) => c.featured).slice(0, 3).map((c: any) => ({ name: c.name, href })),
    }
  })

// §2 sub, verbatim from the ES homepage deck
const sub =
  'Un solo cuadro operativo de su territorio y de su operación, del satélite al SCADA y al campo, operado en su país y de su propiedad desde el primer día.'
---

<MarketingLayout lang="es" title="Industrias | Quatro" description={sub}>
  <HeroCanvas
    badge="Industrias"
    title="Hacemos inteligente la infraestructura crítica."
    body={sub}
    ctaLabel="Hable con nuestro equipo"
    ctaHref="/es/contact/demo"
  />

  <Section>
    <div class="space-y-6">
      {industries.map((industry: any, i: number) => (
        <IndustryHubCard
          title={industry.title}
          description={industry.description}
          href={industry.href}
          heroImage={industry.heroImage}
          solutions={industry.solutions}
          reverse={i % 2 === 1}
          lang="es"
        />
      ))}
    </div>
  </Section>

  <DualCta
    primaryCta={{ label: 'Hable con nuestro equipo', href: '/es/contact/demo' }}
    secondaryCta={{ label: 'Cómo se ejecuta un compromiso', href: '/es/how-it-works/engagement' }}
    microcopy="Alojado en su país · Su equipo es dueño desde el primer día"
  />
</MarketingLayout>
