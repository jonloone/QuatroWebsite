---
import { getCollection } from 'astro:content'
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import HeroCanvas from '@/components/marketing/HeroCanvas.astro'
import StatStrip from '@/components/marketing/StatStrip.astro'
import Section from '@/components/marketing/Section.astro'
import FeatureGrid from '@/components/marketing/FeatureGrid.astro'
import DualCta from '@/components/marketing/DualCta.astro'
import ProofPointCard from '@/components/marketing/ProofPointCard.astro'
import BentoUseCases from '@/components/marketing/BentoUseCases.astro'
import EditorialCapability from '@/components/marketing/EditorialCapability.astro'
import SpineBand from '@/components/marketing/SpineBand.astro'
import { layersEs, layerPromiseEs, engagementLadderEs } from '@/lib/layers'

export async function getStaticPaths() {
  const industries = await getCollection('industries-es')
  return industries.map((industry) => ({
    params: { slug: industry.id.replace(/\.md$/, '') },
    props: { industry },
  }))
}

const { industry } = Astro.props
const { Content } = await industry.render()
const { title, tagline, description, hero, heroImage, challenges, capabilities, stats, platformMapping, proofPoint, cta, proofBadge, authorityLine, proofCards, layerCaptions } = industry.data

// Banda de tres capas (§2, §7): titulares fijos; leyenda por industria solo si el contenido la trae
const layerBeats = layersEs.map((layer) => ({
  id: layer.id,
  index: layer.index,
  label: layer.label,
  oneLiner: layer.headline,
  caption: layerCaptions?.[layer.id],
}))

const featuredCapabilities = capabilities.filter((c: any) => c.featured)
const hasFeatured = featuredCapabilities.length > 0

// Default CTA values
const ctaPrimary = cta?.primary || { label: 'Agende una Evaluación', href: '/es/contact/demo' }
const ctaSecondary = cta?.secondary || { label: 'Hable con un Ingeniero', href: '/es/contact/sales' }
---

<MarketingLayout
  lang="es"
  title={`${title} — ${tagline}`}
  description={description}
>
  <HeroCanvas
    badge={hero.eyebrow}
    title={hero.title}
    body={hero.description}
    ctaLabel={hero.primaryCta?.label || 'Solicitar Evaluación'}
    ctaHref={hero.primaryCta?.href || '/es/contact/demo'}
    imageSrc={heroImage || '/images/hero-bg.png'}
  >
    {proofBadge && (
      <p class="mt-8 inline-block font-mono text-[10px] uppercase tracking-[0.1em] text-white/80 px-4 py-2 rounded-full" style="border: 1px solid rgba(255,255,255,0.25);">
        {proofBadge}
      </p>
    )}
  </HeroCanvas>

  <!-- Banda de tres capas (REALIGNMENT_2026-10-20 §2, §7) -->
  <SpineBand beats={layerBeats} promise={layerPromiseEs} foundation={null} ariaLabel="Territorio, operación, la capa de Quatro" />

  {stats?.length > 0 && <StatStrip stats={stats} />}

  <!-- Industry Challenges Grid -->
  <Section divider>
    <FeatureGrid
      title={`Desafíos en ${title}`}
      subtitle="Puntos críticos operativos en su industria."
      features={challenges.map(c => ({ name: c.title, description: c.description, image: c.image }))}
      columns={challenges.length === 4 ? 4 : challenges.length === 3 ? 3 : 2}
    />
  </Section>

  <!-- Capabilities Section -->
  {hasFeatured ? (
    <Section divider dark>
      <BentoUseCases
        title="Cómo Quatro le Ayuda"
        subtitle={`Capacidades diseñadas para operaciones de ${title.toLowerCase()}.`}
        capabilities={capabilities}
      />
    </Section>
  ) : (
    <Section divider dark>
      <FeatureGrid
        dark
        title="Cómo Quatro le Ayuda"
        subtitle={`Capacidades diseñadas para operaciones de ${title.toLowerCase()}.`}
        features={capabilities.map(c => ({ name: c.name, description: c.description, icon: c.icon }))}
        columns={3}
      />
    </Section>
  )}

  <!-- Línea de autoridad (§4 punto 5) -->
  {authorityLine && (
    <section class="py-16 lg:py-20 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
      <div class="mx-auto max-w-5xl">
        <p class="font-sans font-light text-xl lg:text-2xl leading-relaxed tracking-tight max-w-4xl" style="color: var(--color-neutral-800);">
          {authorityLine}
        </p>
      </div>
    </section>
  )}

  <!-- Fila de prueba (§4 punto 7): sin imagen, marcador honesto -->
  {proofCards && proofCards.length > 0 && (
    <section class="py-24 lg:py-32 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
      <div class="mx-auto max-w-6xl">
        <p class="font-mono text-[10px] uppercase tracking-[0.1em] mb-12" style="color: var(--color-forest);">Prueba</p>
        <div class={`grid grid-cols-1 ${proofCards.length > 1 ? 'lg:grid-cols-2' : ''} gap-8`}>
          {proofCards.map((card: any) => (
            <article class="rounded-xl overflow-hidden" style="border: 1px solid var(--color-structure);">
              {card.asset ? (
                <div class="aspect-[16/9] overflow-hidden" style="background: #111;">
                  <img src={card.asset} alt="" class="img-technical w-full h-full object-cover" loading="lazy" />
                </div>
              ) : (
                <div class="aspect-[16/9] flex items-center justify-center" style="background: var(--color-neutral-100);">
                  <p class="font-mono text-[10px] uppercase tracking-[0.1em]" style="color: var(--color-neutral-400);">Captura en preparación.</p>
                </div>
              )}
              <div class="p-6 lg:p-8">
                <h3 class="font-sans font-light text-xl lg:text-2xl tracking-tight leading-[1.2] mb-6" style="color: var(--color-neutral-800);">{card.title}</h3>
                <dl class="space-y-4">
                  <div>
                    <dt class="font-mono text-[10px] uppercase tracking-[0.1em] mb-1" style="color: var(--color-forest);">Lo que vio el operador</dt>
                    <dd class="font-sans text-sm leading-relaxed" style="color: var(--color-neutral-500);">{card.saw}</dd>
                  </div>
                  <div>
                    <dt class="font-mono text-[10px] uppercase tracking-[0.1em] mb-1" style="color: var(--color-forest);">Lo que hizo el equipo</dt>
                    <dd class="font-sans text-sm leading-relaxed" style="color: var(--color-neutral-500);">{card.did}</dd>
                  </div>
                  <div>
                    <dt class="font-mono text-[10px] uppercase tracking-[0.1em] mb-1" style="color: var(--color-forest);">Lo que tomó</dt>
                    <dd class="font-sans text-sm leading-relaxed" style="color: var(--color-neutral-500);">{card.took}</dd>
                  </div>
                </dl>
                {card.href && (
                  <a href={card.href} class="inline-block mt-6 font-mono text-[10px] uppercase tracking-[0.1em]" style="color: var(--color-forest);">Ver la referencia</a>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Párrafo de compromiso (§2, §4 punto 8) -->
  <section class="py-20 lg:py-28 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
    <div class="mx-auto max-w-5xl grid grid-cols-1 lg:grid-cols-[35%_1fr] gap-10 lg:gap-16">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.1em]" style="color: var(--color-forest);">Cómo se ejecuta un compromiso</p>
      </div>
      <div>
        <p class="font-sans text-base lg:text-lg leading-relaxed" style="color: var(--color-neutral-500);">{engagementLadderEs}</p>
      </div>
    </div>
  </section>

  <!-- Proof Point — hidden until real case studies are available -->

  <DualCta
    title={`Vea la Inteligencia Operacional para ${title}`}
    description={`Elija un desafío de ${title.toLowerCase()}. Desplegamos en sus sistemas en 4 semanas. Vea el valor antes de comprometerse.`}
    primaryCta={ctaPrimary}
    secondaryCta={ctaSecondary}
    microcopy={cta?.microcopy}
  />
</MarketingLayout>
