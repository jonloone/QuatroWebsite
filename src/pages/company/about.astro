---
/**
 * /company/about (REALIGNMENT_2026-10-20 §11, §1e, §1d; COPY_PARTNERS_ABOUT_2026-10 ABOUT-1).
 */
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import Hero from '@/components/marketing/Hero.astro'
import Section from '@/components/marketing/Section.astro'
import DualCta from '@/components/marketing/DualCta.astro'

const sub = 'One operational picture of your territory and your operations, from satellite to SCADA to the field, run in your country and owned by you from day one.'

const facts = [
  { label: 'Where we are', text: 'Headquartered in Quito, Ecuador, with a US entity.' },
  { label: 'Where we work', text: 'Active in Ecuador, Colombia, Venezuela, Panama and Guyana, and in MENA through a channel partner.' },
  { label: 'Ventures', text: 'The same team also builds Sphera and Occupy, each under its own brand.' },
]
---

<MarketingLayout title="About | Quatro" description={sub}>
  <Hero
    eyebrow="About Quatro"
    title="Making critical infrastructure intelligent."
    description={sub}
  />

  <Section>
    <div class="grid gap-12 lg:grid-cols-[35%_1fr]">
      <div>
        <h2 class="font-display text-2xl font-bold text-neutral-800">Our mission</h2>
      </div>
      <p class="text-lg text-neutral-600">We exist to make critical infrastructure intelligent.</p>
    </div>
    <div class="mt-16 grid gap-10 sm:grid-cols-2">
      {facts.map((fact) => (
        <div class="pt-6" style="border-top: 1px solid var(--color-structure);">
          <p class="font-mono text-[10px] uppercase tracking-[0.1em] mb-3" style="color: var(--color-forest);">{fact.label}</p>
          <p class="text-base leading-relaxed text-neutral-700">{fact.text}</p>
        </div>
      ))}
    </div>
  </Section>

  <DualCta
    primaryCta={{ label: 'Talk to our team', href: '/contact/demo' }}
    secondaryCta={{ label: 'Leadership', href: '/company/leadership' }}
    microcopy="Hosted in your country · Your team owns it from day one"
  />
</MarketingLayout>
