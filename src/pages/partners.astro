---
import BaseLayout from '@/layouts/BaseLayout.astro'
import SiteHeader from '@/components/layout/SiteHeader.astro'
import SiteFooter from '@/components/layout/SiteFooter.astro'
import DualCta from '@/components/marketing/DualCta.astro'

// Copy: docs/COPY_PARTNERS_ABOUT_2026-10.md (REALIGNMENT_2026-10-20 §11, §1e)
const sub = 'You hold the client relationship and know the market. Quatro integrates and operates the operational picture behind you, in your country, and the client owns it from day one.'

const tiers = [
  { name: 'The local partner', text: 'Leads the client relationship and the proposal, and is the single contracting counterparty on the program.' },
  { name: 'Quatro', text: 'Integrates the systems, the sensing and the satellite picture, and operates the result in the country with the client\'s team.' },
  { name: 'Technology partners', text: 'The technology underneath: DataMiner xOps for the operational model and Klarety for earth observation.' },
]

const brings = [
  { name: 'Sensing', text: 'The Quatro IoT & Edge Suite and OT communications, placed only where confirmed risk justifies it.' },
  { name: 'Security and evidence', text: 'Chain-of-custody records and the operational agents that assemble them.' },
  { name: 'Data integration', text: 'The systems the client already runs, brought into one operational model.' },
  { name: 'In-country operation', text: 'Hosting, support in Spanish, hypercare and a forward-deployed engineer.' },
  { name: 'Proposal support', text: 'Scoping, the proof-of-value plan and the technical sections of the proposal.' },
]

const markets = ['Ecuador', 'Colombia', 'Venezuela', 'Panama', 'Guyana', 'MENA (through a channel partner)']

const ideal = [
  { name: 'Local primes with past performance', text: 'In energy, environment, mining, public services or security programs.' },
  { name: 'Geospatial and engineering firms', text: 'That already work the territory and the plant.' },
  { name: 'Programs aligned with development banks', text: 'Where a consortium led by a local prime delivers in tranches.' },
]
---

<BaseLayout
  title="Partners | Quatro"
  description={sub}
  lang="en"
>

  <SiteHeader lang="en" />

  <!-- ═══════════════════════════════════════════════════════════════
       1. HERO — Photo top, clean text bottom (KT Practice style)
       ═══════════════════════════════════════════════════════════════ -->

  <!-- 1a. Photo band — full-bleed monotone image across top -->
  <section class="relative overflow-hidden" style="height: clamp(320px, 45vh, 520px);" data-nav-light>
    <img
      src="/images/bg-partners-hero-v2.png"
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-center"
      style="filter: grayscale(100%) contrast(0.7) brightness(1.1);"
      loading="eager"
      aria-hidden="true"
    />
    <!-- Sage-green monotone tint -->
    <div class="absolute inset-0" style="background-color: rgba(180, 190, 170, 0.6); mix-blend-mode: multiply;"></div>
    <div class="absolute inset-0" style="background-color: rgba(210, 215, 200, 0.35); mix-blend-mode: screen;"></div>
    <!-- Bottom fade into the text section below -->
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, transparent 60%, rgba(206, 210, 198, 1) 100%);"></div>
    <!-- Grain -->
    <div class="absolute inset-0 opacity-[0.05] pointer-events-none"
      style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%270 0 256 256%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cfilter id=%27noise%27%3E%3CfeTurbulence type=%27fractalNoise%27 baseFrequency=%270.65%27 numOctaves=%273%27 stitchTiles=%27stitch%27/%3E%3C/filter%3E%3Crect width=%27100%25%27 height=%27100%25%27 filter=%27url(%23noise)%27/%3E%3C/svg%3E');"></div>
  </section>

  <!-- 1b. Text band — solid sage background, no image competition -->
  <section class="relative px-8 lg:px-12 pt-12 lg:pt-16 pb-24 lg:pb-32 overflow-hidden" style="background-color: rgb(206, 210, 198);">
    <!-- Grain continuity -->
    <div class="absolute inset-0 opacity-[0.04] pointer-events-none"
      style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%270 0 256 256%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cfilter id=%27noise%27%3E%3CfeTurbulence type=%27fractalNoise%27 baseFrequency=%270.65%27 numOctaves=%273%27 stitchTiles=%27stitch%27/%3E%3C/filter%3E%3Crect width=%27100%25%27 height=%27100%25%27 filter=%27url(%23noise)%27/%3E%3C/svg%3E');"></div>

    <div class="relative z-10 mx-auto max-w-5xl">

      <p class="font-mono text-[10px] uppercase tracking-[0.1em] mb-8 fade-up" style="color: rgba(26,26,26,0.5);">Partners</p>

      <h1 class="font-sans font-light text-4xl sm:text-5xl lg:text-7xl xl:text-8xl leading-[1.05] tracking-tight fade-up" style="color: #1a1a1a;">
        Deliver the operational picture<br />in your market.
      </h1>

      <div class="mt-10 lg:mt-14 grid grid-cols-1 lg:grid-cols-[1fr_35%] gap-12 lg:gap-20">
        <p class="font-sans text-lg lg:text-xl leading-relaxed fade-up" style="color: rgba(26,26,26,0.65);">
          {sub}
        </p>
        <div class="flex items-end">
          <a href="/contact/demo" class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.1em] transition-colors duration-300 hover:text-[#1a1a1a] fade-up" style="color: rgba(26,26,26,0.55);">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
            Talk to our team
          </a>
        </div>
      </div>

    </div>
  </section>


  <!-- 2. THE CHANNEL (three tiers) -->
  <section class="py-24 lg:py-32 px-8 lg:px-12">
    <div class="mx-auto max-w-5xl grid grid-cols-1 lg:grid-cols-[35%_1fr] gap-10 lg:gap-16">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.1em]" style="color: var(--color-forest);">The channel</p>
      </div>
      <ol class="space-y-10">
        {tiers.map((tier, i) => (
          <li class="grid grid-cols-[40px_1fr] gap-4 items-start">
            <span class="font-mono text-[10px] uppercase tracking-[0.1em] pt-1.5" style="color: var(--color-forest);">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h2 class="font-sans text-lg lg:text-xl font-medium tracking-tight mb-2" style="color: var(--color-neutral-800);">{tier.name}</h2>
              <p class="font-sans text-base leading-relaxed" style="color: var(--color-neutral-500);">{tier.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 3. WHAT QUATRO BRINGS A PARTNER -->
  <section class="py-24 lg:py-32 px-8 lg:px-12" style="background: var(--color-paper); border-top: 1px solid var(--color-structure);">
    <div class="mx-auto max-w-6xl">
      <p class="font-mono text-[10px] uppercase tracking-[0.1em] mb-12" style="color: var(--color-forest);">What Quatro brings a partner</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {brings.map((item) => (
          <div class="rounded-xl p-6 lg:p-8" style="border: 1px solid var(--color-structure);">
            <h3 class="font-sans text-lg font-medium tracking-tight mb-3" style="color: var(--color-neutral-800);">{item.name}</h3>
            <p class="font-sans text-sm leading-relaxed" style="color: var(--color-neutral-500);">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. ACTIVE MARKETS (§1e) -->
  <section class="py-20 lg:py-24 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
    <div class="mx-auto max-w-5xl grid grid-cols-1 lg:grid-cols-[35%_1fr] gap-10 lg:gap-16">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.1em]" style="color: var(--color-forest);">Active markets</p>
      </div>
      <ul class="grid grid-cols-2 sm:grid-cols-3 gap-6">
        {markets.map((m) => (
          <li class="font-sans text-base" style="color: var(--color-neutral-800);">{m}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. IDEAL PARTNERS -->
  <section class="py-24 lg:py-32 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
    <div class="mx-auto max-w-5xl grid grid-cols-1 lg:grid-cols-[35%_1fr] gap-10 lg:gap-16">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.1em]" style="color: var(--color-forest);">Ideal partners</p>
      </div>
      <ul class="space-y-8">
        {ideal.map((item) => (
          <li>
            <h3 class="font-sans text-lg font-medium tracking-tight mb-2" style="color: var(--color-neutral-800);">{item.name}</h3>
            <p class="font-sans text-base leading-relaxed" style="color: var(--color-neutral-500);">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 6. OWNERSHIP LINE -->
  <section class="py-16 lg:py-20 px-8 lg:px-12" style="border-top: 1px solid var(--color-structure);">
    <p class="mx-auto max-w-5xl font-sans font-light text-xl lg:text-2xl leading-relaxed tracking-tight" style="color: var(--color-neutral-800);">
      Every engagement leaves the client owning the data, the derived products and the operational model.
    </p>
  </section>

  <DualCta
    title="Tell us about your market and the program you are pursuing."
    primaryCta={{ label: 'Talk to our team', href: '/contact/demo' }}
    secondaryCta={{ label: 'How an engagement runs', href: '/how-it-works/engagement' }}
    microcopy="Hosted in your country · Your client owns it from day one"
  />

  <SiteFooter />

</BaseLayout>
