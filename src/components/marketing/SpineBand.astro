---
/**
 * SpineBand — the Sense → Unify → Act band (REALIGNMENT_2026-06-08 §1, §3).
 * Renders the three beats from the spine data as the narrative centerpiece.
 *
 * Each beat exposes a named slot (`sense` | `unify` | `act`) so a demo slot
 * (DEMO-1) can be injected per beat. This component does not depend on the
 * DemoSlot component existing — a beat with no slot content simply renders its
 * copy. Visual system per quatro-ui-system (forest tokens, Roobert display,
 * JetBrains Mono eyebrow labels, structure-grey borders).
 */
import Container from '@/components/ui/Container.astro'
import { spineBeats, spinePromise, spineFoundation } from '@/lib/spine'

interface Props {
  /** Extra classes on the section wrapper. */
  class?: string
  /** Show the promise line above the band. Default true. */
  showPromise?: boolean
}

const { class: className, showPromise = true } = Astro.props
---

<section
  class:list={['py-16 sm:py-24', className]}
  style="border-top: 1px solid var(--color-structure);"
  aria-label="Sense, Unify, Act"
>
  <Container>
    {showPromise && (
      <p class="text-center font-display text-2xl tracking-tight text-neutral-800 sm:text-3xl">
        {spinePromise}
      </p>
    )}

    <div class:list={['grid gap-8 lg:grid-cols-3', showPromise && 'mt-12']}>
      {spineBeats.map((beat) => (
        <div class="relative flex flex-col bg-neutral-50 p-8" style="border: 1px solid var(--color-structure);">
          <div class="mb-4 flex items-baseline gap-3">
            <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-brand-600">{beat.index}</span>
            <h3 class="font-display text-xl tracking-tight text-neutral-800">{beat.label}</h3>
          </div>
          <p class="text-sm leading-relaxed text-neutral-700">{beat.oneLiner}</p>
          <p class="mt-4 font-mono text-[10px] uppercase tracking-[0.1em] text-neutral-500">{beat.proofSurface}</p>
          {beat.id === 'sense' && Astro.slots.has('sense') && <div class="mt-6"><slot name="sense" /></div>}
          {beat.id === 'unify' && Astro.slots.has('unify') && <div class="mt-6"><slot name="unify" /></div>}
          {beat.id === 'act' && Astro.slots.has('act') && <div class="mt-6"><slot name="act" /></div>}
        </div>
      ))}
    </div>

    <p class="mt-10 text-center text-sm text-neutral-500">{spineFoundation}</p>
  </Container>
</section>
